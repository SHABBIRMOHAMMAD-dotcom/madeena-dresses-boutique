# Madeena Dresses - Boutique Backend API Environment Configuration

# Server Port
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# Boutique Business Receiving Inbox (Mother's Business Email)
# All incoming customer dress orders and bespoke inquiries are sent here
STORE_EMAIL=shabbirmohammad413@gmail.com

# SMTP Server Credentials (for automated Nodemailer email notifications)
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-boutique-email@gmail.com
SMTP_PASS=your-16-character-app-password

# Sender Display Name and Address
EMAIL_FROM="Madeena Dresses Boutique" <orders@madeenadresses.com>

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

